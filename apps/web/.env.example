# Accounts and levels come from https://api.vin.ski; for a local Spotcraft (its `pnpm dev`):
# NUXT_SPOTCRAFT_URL=http://localhost:3003
# NUXT_PUBLIC_SPOTCRAFT_URL=http://localhost:3003
# Sokobanko's Spotcraft key (sc_…), for reading levels and players' files, and saving
# results (server-only; never commit it). Results go to api.vin.ski unless
# NUXT_SPOTCRAFT_URL points at a local Spotcraft.
NUXT_SPOTCRAFT_KEY=
