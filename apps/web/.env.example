# The completions database: the local stack from `pnpm supabase start` (see
# `pnpm supabase status`). Only the server uses it.
NUXT_SUPABASE_URL=http://127.0.0.1:54621
# Server-only; bypasses RLS. This is the fixed key of the local stack, never a real one.
NUXT_SUPABASE_SECRET_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz
# Accounts and levels come from https://api.vin.ski; for a local Spotcraft (its `pnpm dev`):
# NUXT_SPOTCRAFT_URL=http://localhost:3003
# NUXT_PUBLIC_SPOTCRAFT_URL=http://localhost:3003
# Spotcraft's ADMIN_SECRET, for saving players' results (server-only; never commit it).
# Results go to api.vin.ski unless NUXT_SPOTCRAFT_URL points at a local Spotcraft.
NUXT_SPOTCRAFT_ADMIN_SECRET=
