# The local database and guest sessions (Spotcraft's local stack, from apps/web):
#   npx spotcraft dev start --name sokobanko
#   npx spotcraft dev env --write --name sokobanko
# The second writes DATABASE_URL and AUTH_SECRET here; add PUBLIC_URL yourself.
DATABASE_URL=
AUTH_SECRET=
PUBLIC_URL=http://localhost:3000

# Until step 2 of the move to Spotcraft 0.2.0, levels and results still come
# from the old hosted Spotcraft at https://api.vin.ski with Sokobanko's key.
NUXT_SPOTCRAFT_KEY=
