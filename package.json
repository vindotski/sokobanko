{
  "name": "sokobanko",
  "version": "0.8.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "typecheck": "nuxt typecheck && pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "test:storybook": "vitest run --project 'storybook-*'",
    "storybook": "storybook dev -p 6006 --no-open --disable-telemetry",
    "build-storybook": "storybook build -o storybook-static --disable-telemetry",
    "test:unit": "vitest run --project unit",
    "self-host": "docker build -t sokobanko:self-host . && LEGAL_FACTS=\"$(cat self-host/legal-facts.json)\" docker compose -f self-host/compose.yaml up -d --wait && docker compose -f self-host/compose.yaml run --rm --no-deps --entrypoint /nodejs/bin/node app .output/server/index.mjs migrate",
    "self-host:smoke": "node scripts/smoke.ts",
    "self-host:down": "docker compose -f self-host/compose.yaml down -v"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@kodentuzo/spotkit": "0.2.0",
    "@kodentuzo/spotstrap": "0.2.0",
    "@lucide/vue": "^1.61.0",
    "@nuxtjs/color-mode": "4.0.1",
    "@sokobanko/core": "workspace:*",
    "@sokobanko/game": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/db": "1.0.0-rc.1.5",
    "@tanstack/offline-transactions": "1.2.1",
    "@tanstack/query-db-collection": "1.5.2",
    "@tanstack/vue-db": "1.0.0-rc.1.5",
    "@tanstack/vue-query": "5.108.1",
    "@vueuse/core": "^15.0.0",
    "better-auth": "1.7.25",
    "canvas-confetti": "1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "drizzle-orm": "^0.45.4",
    "embla-carousel-vue": "^8.6.0",
    "nuxt": "^4.6.2",
    "pg": "8.23.1",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@kodentuzo/spotcraft": "0.9.1",
    "@storybook-vue/nuxt": "10.0.3",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-vitest": "10.6.7",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@vitest/browser-playwright": "5.1.1",
    "drizzle-kit": "^0.31.11",
    "playwright": "1.65.1",
    "shadcn-nuxt": "^2.8.2",
    "storybook": "10.6.7",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.13"
  }
}
