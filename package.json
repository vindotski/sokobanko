{
  "name": "sokoban",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:types": "supabase gen types typescript --local > apps/web/app/types/database.types.ts && biome check --write apps/web/app/types",
    "levels:check": "node --conditions=source ../spotcraft-main/packages/spotcraft/src/index.ts check content",
    "levels:import": "pnpm levels:check && node bin/levels-import.ts",
    "levels:export": "node bin/levels-export.ts",
    "progress:export": "node bin/progress-export.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/node": "^26.6.5",
    "supabase": "2.122.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
