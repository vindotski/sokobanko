# The local database and guest sessions (Spotcraft's local stack, from the repository root):
#   npx spotcraft dev start --name sokobanko
#   npx spotcraft dev env --write --name sokobanko
# The second writes DATABASE_URL and AUTH_SECRET here; add PUBLIC_URL yourself.
DATABASE_URL=
AUTH_SECRET=
PUBLIC_URL=http://localhost:3000

# Who runs Sokobanko, for the privacy policy, terms and legal notice. The name
# and email have defaults; the address is only ever set here or on Spotcraft,
# never in the code. Lines are separated by \n.
NUXT_PUBLIC_LEGAL_ADDRESS=
# NUXT_PUBLIC_LEGAL_NAME=
# NUXT_PUBLIC_LEGAL_EMAIL=
# NUXT_PUBLIC_LEGAL_COUNTRY=

