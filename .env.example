# The local database, guest sessions, mail and legal facts (Spotkit's local
# stack, from the repository root; needs Docker):
#   pnpm exec spotkit dev
# It adds the names below to .env when they are missing, and keeps serving the
# analytics and legal stand-ins until Ctrl+C. Spotcraft sets the same names on
# a server.
DATABASE_URL=
DATABASE_SCHEMA=
AUTH_URL=
AUTH_ISSUER=
AUTH_JWKS_URL=
PUBLIC_URL=http://localhost:3000

# Where the server reads the legal facts (facts schema v1) for the privacy
# notice, terms and legal notice. On Spotcraft it is empty: the server asks
# PUBLIC_URL's /_spotcraft/legal.json. `spotkit dev` points it at its stand-in.
LEGAL_URL=
